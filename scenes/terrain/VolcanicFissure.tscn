[gd_scene load_steps=16 format=3]

[ext_resource type="Shader" path="res://shaders/lava.gdshader" id="1_lava"]

[sub_resource type="GDScript" id="GDScript_flicker"]
script/source = "extends OmniLight3D

var _t: float = 0.0

func _process(delta: float) -> void:
	_t += delta
	light_energy = 3.0 + sin(_t * 9.0) * 0.4 + sin(_t * 23.0 + 1.3) * 0.25
"

